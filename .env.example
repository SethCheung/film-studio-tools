# Film Studio Tools - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=3000

# 飞书自建应用配置
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# M3 Ultra oMLX 配置 (Qwen3.5-397B)
M3_ULTRA_URL=http://192.168.1.123:8001
M3_ULTRA_MODEL=Qwen3.5-397B-A17B-4bit
M3_ULTRA_API_KEY=123456

# AI Max LLM 配置 (Qwen3-72B)
AIMAX_URL=http://192.168.1.238:8080
AIMAX_MODEL=Qwen3-72B-Instruct-Q5_K_M
